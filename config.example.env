# Copy to config.env (gitignored) and edit.

# LAN interface whose IPv4 address the server binds to.
IFACE=enp12s0
PORT=8080

# Any llama.cpp built-in preset or normal model flags (e.g. -hf user/repo:quant).
MODEL_PRESET=--vision-gemma-12b-default

# "localhost" permits http://localhost:<any-port>, http://127.0.0.1:<any-port>
# and http://[::1]:<any-port>. For anything else use exact origins, comma-separated:
# CORS_ORIGINS=http://localhost:3000,http://engram.local
CORS_ORIGINS=localhost

# API key file (one key per line, 0600). Generated automatically if missing.
# API_KEY_FILE=$HOME/.config/llama-lan/api-keys

# llama.cpp Web UI (disabled by default; this box only needs the API).
# ENABLE_WEBUI=0
# ENABLE_METRICS=0

# Native TLS (optional upgrade from plain HTTP). Set both or neither.
# TLS_CERT=$HOME/.config/llama-lan/tls/cert.pem
# TLS_KEY=$HOME/.config/llama-lan/tls/key.pem
# CURL_INSECURE=1   # allow the status/health checks to accept a self-signed cert
